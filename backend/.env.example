SUPABASE_URL=https://YOUR_PROJECT.supabase.co
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER:5432/postgres?sslmode=require
# Local development can read the public key from frontend/.env; Compose passes it explicitly.
SUPABASE_PUBLISHABLE_KEY=
# Server only; required for deleting the Supabase Auth identity.
SUPABASE_SECRET_KEY=
CORS_ORIGINS=https://careerflow.live,http://localhost:3000,http://127.0.0.1:3000
# Optional: comma-separated Supabase UUIDs of the developer, to prevent mislabeling owner feedback.
DEVELOPER_SUPABASE_USER_IDS=

# Backend runtime only. Never put this key in frontend/.env or Docker build args.
# Dedicated server key for demo preview; falls back to legacy API_KEY if unset.
GEMINI_DEMO_API_KEY=
GEMINI_DEMO_MODEL=gemini-3.5-flash-lite
GEMINI_DEMO_ENABLED=false
GEMINI_DEMO_FREE_MESSAGES=3
GEMINI_DEMO_GLOBAL_DAILY_LIMIT=100

# Optional deployment paths; defaults are resolved from the backend installation.
# MODELS_DIR=/app/backend/models
# DATA_DIR=/app/backend/data
# FRONTEND_BUILD_DIR=/app/frontend/build
# CANONICAL_ORIGIN=https://careerflow.live
